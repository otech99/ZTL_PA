  "seed": "ts-node src/seed/seed.ts",
  "generate-keys": "mkdir -p keys && openssl genrsa -out keys/jwtRS256.key 2048 && openssl rsa -in keys/jwtRS256.key -pubout -out keys/jwtRS256.key.pub"
 },
