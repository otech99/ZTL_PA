{
  "info": {"name": "ZTL_PA", "description": "Test delle rotte del backend ZTL_PA. Importare anche l'environment ZTL_PA e selezionarlo prima dell'esecuzione. Eseguire prima la cartella Auth (salva i token), poi le altre in ordine, oppure tutta la collection con il Runner. Richiede il database inizializzato con npm run seed.", "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"},
  "item": [
    {
      "name": "Auth",
      "description": "Login dei quattro ruoli del seed: ogni richiesta salva il token nella variabile della collection.",
      "item": [
        {"name": "Login operatore", "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('Status 200', () => pm.response.to.have.status(200));", "pm.environment.set('tokenOperatore', pm.response.json().token);"]}}], "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "url": "{{baseUrl}}/auth/login", "auth": {"type": "noauth"}, "body": {"mode": "raw", "raw": "{\"email\": \"operatore@ztl.it\", \"password\": \"password123\"}"}}},
        {"name": "Login varco", "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('Status 200', () => pm.response.to.have.status(200));", "pm.environment.set('tokenVarco', pm.response.json().token);"]}}], "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "url": "{{baseUrl}}/auth/login", "auth": {"type": "noauth"}, "body": {"mode": "raw", "raw": "{\"email\": \"varco@ztl.it\", \"password\": \"password123\"}"}}},
        {"name": "Login automobilista", "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('Status 200', () => pm.response.to.have.status(200));", "pm.environment.set('tokenAutomobilista', pm.response.json().token);"]}}], "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "url": "{{baseUrl}}/auth/login", "auth": {"type": "noauth"}, "body": {"mode": "raw", "raw": "{\"email\": \"automobilista@ztl.it\", \"password\": \"password123\"}"}}},
        {"name": "Login admin", "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('Status 200', () => pm.response.to.have.status(200));", "pm.environment.set('tokenAdmin', pm.response.json().token);"]}}], "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "url": "{{baseUrl}}/auth/login", "auth": {"type": "noauth"}, "body": {"mode": "raw", "raw": "{\"email\": \"admin@ztl.it\", \"password\": \"password123\"}"}}},
        {"name": "Login con password errata", "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('Status 401', () => pm.response.to.have.status(401));"]}}], "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "url": "{{baseUrl}}/auth/login", "auth": {"type": "noauth"}, "body": {"mode": "raw", "raw": "{\"email\": \"operatore@ztl.it\", \"password\": \"passwordsbagliata\"}"}}},
        {"name": "Login con email non valida", "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('Status 400', () => pm.response.to.have.status(400));"]}}], "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "url": "{{baseUrl}}/auth/login", "auth": {"type": "noauth"}, "body": {"mode": "raw", "raw": "{\"email\": \"operatore\", \"password\": \"password123\"}"}}}
      ]
    },
    {
      "name": "ZTL",
      "description": "CRUD delle ZTL, riservato all'operatore.",
      "item": [
        {"name": "Crea ZTL", "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('Status 201', () => pm.response.to.have.status(201));", "pm.environment.set('ztlId', pm.response.json().id);", "pm.environment.set('ztlNome', pm.response.json().nome);"]}}], "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "url": "{{baseUrl}}/ztl", "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{tokenOperatore}}", "type": "string"}]}, "body": {"mode": "raw", "raw": "{\"nome\": \"ZTL Postman {{$timestamp}}\", \"citta\": \"Ancona\"}"}}},
        {"name": "Elenco ZTL", "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('Status 200', () => pm.response.to.have.status(200));"]}}], "request": {"method": "GET", "url": "{{baseUrl}}/ztl", "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{tokenOperatore}}", "type": "string"}]}}},
        {"name": "Dettaglio ZTL", "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('Status 200', () => pm.response.to.have.status(200));"]}}], "request": {"method": "GET", "url": "{{baseUrl}}/ztl/{{ztlId}}", "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{tokenOperatore}}", "type": "string"}]}}},
        {"name": "Modifica ZTL", "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('Status 200', () => pm.response.to.have.status(200));", "pm.environment.set('ztlNome', pm.response.json().nome);"]}}], "request": {"method": "PUT", "header": [{"key": "Content-Type", "value": "application/json"}], "url": "{{baseUrl}}/ztl/{{ztlId}}", "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{tokenOperatore}}", "type": "string"}]}, "body": {"mode": "raw", "raw": "{\"nome\": \"{{ztlNome}} modificata\", \"citta\": \"Ancona\"}"}}},
        {"name": "Crea ZTL già esistente", "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('Status 409', () => pm.response.to.have.status(409));"]}}], "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "url": "{{baseUrl}}/ztl", "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{tokenOperatore}}", "type": "string"}]}, "body": {"mode": "raw", "raw": "{\"nome\": \"Centro Storico\", \"citta\": \"Ancona\"}"}}},
        {"name": "Crea ZTL con campo non ammesso", "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('Status 400', () => pm.response.to.have.status(400));"]}}], "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "url": "{{baseUrl}}/ztl", "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{tokenOperatore}}", "type": "string"}]}, "body": {"mode": "raw", "raw": "{\"nome\": \"Prova\", \"citta\": \"Ancona\", \"colore\": \"rosso\"}"}}},
        {"name": "Elenco ZTL senza token", "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('Status 401', () => pm.response.to.have.status(401));"]}}], "request": {"method": "GET", "url": "{{baseUrl}}/ztl", "auth": {"type": "noauth"}}},
        {"name": "Elenco ZTL come automobilista", "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('Status 403', () => pm.response.to.have.status(403));"]}}], "request": {"method": "GET", "url": "{{baseUrl}}/ztl", "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{tokenAutomobilista}}", "type": "string"}]}}},
        {"name": "Crea ZTL da eliminare", "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('Status 201', () => pm.response.to.have.status(201));", "pm.environment.set('ztlTemporaneaId', pm.response.json().id);"]}}], "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "url": "{{baseUrl}}/ztl", "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{tokenOperatore}}", "type": "string"}]}, "body": {"mode": "raw", "raw": "{\"nome\": \"ZTL temporanea {{$timestamp}}\", \"citta\": \"Ancona\"}"}}},
        {"name": "Elimina ZTL", "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('Status 204', () => pm.response.to.have.status(204));"]}}], "request": {"method": "DELETE", "url": "{{baseUrl}}/ztl/{{ztlTemporaneaId}}", "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{tokenOperatore}}", "type": "string"}]}}},
        {"name": "Dettaglio ZTL eliminata", "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('Status 404', () => pm.response.to.have.status(404));"]}}], "request": {"method": "GET", "url": "{{baseUrl}}/ztl/{{ztlTemporaneaId}}", "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{tokenOperatore}}", "type": "string"}]}}}
      ]
    },
    {
      "name": "Varchi",
      "description": "CRUD dei varchi con le loro fasce orarie, riservato all'operatore. Il body usa ztlId salvato dalla cartella ZTL.",
      "item": [
        {"name": "Crea varco", "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('Status 201', () => pm.response.to.have.status(201));", "pm.environment.set('varcoId', pm.response.json().id);"]}}], "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "url": "{{baseUrl}}/varchi", "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{tokenOperatore}}", "type": "string"}]}, "body": {"mode": "raw", "raw": "{\"posizione\": \"Via Postman\", \"ztlId\": {{ztlId}}, \"fasce\": [{\"giornoSettimana\": 1, \"oraInizio\": \"00:00\", \"oraFine\": \"24:00\", \"maggiorazione\": 1}, {\"giornoSettimana\": 2, \"oraInizio\": \"00:00\", \"oraFine\": \"24:00\", \"maggiorazione\": 1}, {\"giornoSettimana\": 3, \"oraInizio\": \"00:00\", \"oraFine\": \"24:00\", \"maggiorazione\": 1}, {\"giornoSettimana\": 4, \"oraInizio\": \"00:00\", \"oraFine\": \"24:00\", \"maggiorazione\": 1}, {\"giornoSettimana\": 5, \"oraInizio\": \"00:00\", \"oraFine\": \"24:00\", \"maggiorazione\": 1}, {\"giornoSettimana\": 6, \"oraInizio\": \"00:00\", \"oraFine\": \"24:00\", \"maggiorazione\": 1}, {\"giornoSettimana\": 7, \"oraInizio\": \"00:00\", \"oraFine\": \"24:00\", \"maggiorazione\": 1}]}"}, "description": "Varco attivo tutti i giorni, 24 ore su 24, così il transito di prova genera sempre la multa."}},
        {"name": "Elenco varchi", "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('Status 200', () => pm.response.to.have.status(200));"]}}], "request": {"method": "GET", "url": "{{baseUrl}}/varchi", "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{tokenOperatore}}", "type": "string"}]}}},
        {"name": "Dettaglio varco", "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('Status 200', () => pm.response.to.have.status(200));"]}}], "request": {"method": "GET", "url": "{{baseUrl}}/varchi/{{varcoId}}", "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{tokenOperatore}}", "type": "string"}]}}},
        {"name": "Modifica varco", "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('Status 200', () => pm.response.to.have.status(200));"]}}], "request": {"method": "PUT", "header": [{"key": "Content-Type", "value": "application/json"}], "url": "{{baseUrl}}/varchi/{{varcoId}}", "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{tokenOperatore}}", "type": "string"}]}, "body": {"mode": "raw", "raw": "{\"posizione\": \"Via Postman angolo Corso\", \"ztlId\": {{ztlId}}, \"fasce\": [{\"giornoSettimana\": 1, \"oraInizio\": \"00:00\", \"oraFine\": \"24:00\", \"maggiorazione\": 1.5}, {\"giornoSettimana\": 2, \"oraInizio\": \"00:00\", \"oraFine\": \"24:00\", \"maggiorazione\": 1.5}, {\"giornoSettimana\": 3, \"oraInizio\": \"00:00\", \"oraFine\": \"24:00\", \"maggiorazione\": 1.5}, {\"giornoSettimana\": 4, \"oraInizio\": \"00:00\", \"oraFine\": \"24:00\", \"maggiorazione\": 1.5}, {\"giornoSettimana\": 5, \"oraInizio\": \"00:00\", \"oraFine\": \"24:00\", \"maggiorazione\": 1.5}, {\"giornoSettimana\": 6, \"oraInizio\": \"00:00\", \"oraFine\": \"24:00\", \"maggiorazione\": 1}, {\"giornoSettimana\": 7, \"oraInizio\": \"00:00\", \"oraFine\": \"24:00\", \"maggiorazione\": 1}]}"}, "description": "Maggiorazione 1.5 dal lunedì al venerdì."}},
        {"name": "Crea varco con fasce sovrapposte", "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('Status 400', () => pm.response.to.have.status(400));"]}}], "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "url": "{{baseUrl}}/varchi", "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{tokenOperatore}}", "type": "string"}]}, "body": {"mode": "raw", "raw": "{\"posizione\": \"Via Errata\", \"ztlId\": {{ztlId}}, \"fasce\": [{\"giornoSettimana\": 1, \"oraInizio\": \"08:00\", \"oraFine\": \"12:00\"}, {\"giornoSettimana\": 1, \"oraInizio\": \"11:00\", \"oraFine\": \"15:00\"}]}"}}},
        {"name": "Elimina ZTL con varchi collegati", "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('Status 409', () => pm.response.to.have.status(409));"]}}], "request": {"method": "DELETE", "url": "{{baseUrl}}/ztl/{{ztlId}}", "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{tokenOperatore}}", "type": "string"}]}}},
        {"name": "Crea varco da eliminare", "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('Status 201', () => pm.response.to.have.status(201));", "pm.environment.set('varcoTemporaneoId', pm.response.json().id);"]}}], "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "url": "{{baseUrl}}/varchi", "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{tokenOperatore}}", "type": "string"}]}, "body": {"mode": "raw", "raw": "{\"posizione\": \"Varco temporaneo\", \"ztlId\": {{ztlId}}, \"fasce\": []}"}}},
        {"name": "Elimina varco", "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('Status 204', () => pm.response.to.have.status(204));"]}}], "request": {"method": "DELETE", "url": "{{baseUrl}}/varchi/{{varcoTemporaneoId}}", "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{tokenOperatore}}", "type": "string"}]}}}
      ]
    },
    {
      "name": "Transiti",
      "description": "Inserimento dei transiti con calcolo della multa, consultazione per varco, modifica ed eliminazione.",
      "item": [
        {"name": "Transito con multa (feriale)", "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('Status 201', () => pm.response.to.have.status(201));", "const r = pm.response.json();", "pm.test('Multa generata', () => pm.expect(r.multa).to.not.be.null);", "pm.environment.set('transitoConMultaId', r.transito.id);", "pm.environment.set('idBollettino', r.multa.idBollettino);"]}}], "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "url": "{{baseUrl}}/transiti", "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{tokenOperatore}}", "type": "string"}]}, "body": {"mode": "raw", "raw": "{\"targa\": \"AB123CD\", \"dataOra\": \"2026-10-07T10:00:00+02:00\", \"tipo\": \"ingresso\", \"varcoId\": {{varcoId}}}"}, "description": "Mercoledì, auto (tariffa 80) con maggiorazione 1.5: multa di 120."}},
        {"name": "Transito con multa (festivo)", "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('Status 201', () => pm.response.to.have.status(201));", "pm.test('Multa festiva', () => pm.expect(pm.response.json().multa).to.not.be.null);"]}}], "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "url": "{{baseUrl}}/transiti", "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{tokenOperatore}}", "type": "string"}]}, "body": {"mode": "raw", "raw": "{\"targa\": \"AB123CD\", \"dataOra\": \"2026-08-15T10:00:00+02:00\", \"tipo\": \"ingresso\", \"varcoId\": {{varcoId}}}"}, "description": "Ferragosto: si usano le fasce della domenica e la tariffa festiva (80 x 1 x 1.5 = 120)."}},
        {"name": "Secondo transito nello stesso giorno", "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('Status 201', () => pm.response.to.have.status(201));", "pm.test('Nessuna seconda multa', () => pm.expect(pm.response.json().multa).to.be.null);"]}}], "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "url": "{{baseUrl}}/transiti", "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{tokenOperatore}}", "type": "string"}]}, "body": {"mode": "raw", "raw": "{\"targa\": \"AB123CD\", \"dataOra\": \"2026-10-07T12:00:00+02:00\", \"tipo\": \"ingresso\", \"varcoId\": {{varcoId}}}"}, "description": "Stesso veicolo, stesso varco, stesso giorno: la multa non viene ripetuta."}},
        {"name": "Transito veicolo in white list", "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('Status 201', () => pm.response.to.have.status(201));", "const r = pm.response.json();", "pm.test('Nessuna multa', () => pm.expect(r.multa).to.be.null);", "pm.environment.set('transitoId', r.transito.id);"]}}], "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "url": "{{baseUrl}}/transiti", "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{tokenOperatore}}", "type": "string"}]}, "body": {"mode": "raw", "raw": "{\"targa\": \"WL000AA\", \"dataOra\": \"2026-10-07T10:00:00+02:00\", \"tipo\": \"ingresso\", \"varcoId\": {{varcoId}}}"}}},
        {"name": "Transito dal dispositivo del varco", "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('Status 201', () => pm.response.to.have.status(201));"]}}], "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "url": "{{baseUrl}}/transiti", "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{tokenVarco}}", "type": "string"}]}, "body": {"mode": "raw", "raw": "{\"targa\": \"EF456GH\", \"dataOra\": \"2026-10-07T09:00:00+02:00\", \"tipo\": \"ingresso\"}"}, "description": "Il dispositivo non indica il varco: si usa quello a cui è collegato."}},
        {"name": "Dispositivo che indica il varco", "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('Status 400', () => pm.response.to.have.status(400));"]}}], "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "url": "{{baseUrl}}/transiti", "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{tokenVarco}}", "type": "string"}]}, "body": {"mode": "raw", "raw": "{\"targa\": \"EF456GH\", \"dataOra\": \"2026-10-07T09:00:00+02:00\", \"tipo\": \"ingresso\", \"varcoId\": {{varcoId}}}"}}},
        {"name": "Transito veicolo non registrato", "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('Status 404', () => pm.response.to.have.status(404));"]}}], "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "url": "{{baseUrl}}/transiti", "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{tokenOperatore}}", "type": "string"}]}, "body": {"mode": "raw", "raw": "{\"targa\": \"ZZ999ZZ\", \"dataOra\": \"2026-10-07T10:00:00+02:00\", \"tipo\": \"ingresso\", \"varcoId\": {{varcoId}}}"}}},
        {"name": "Transito con targa come numero", "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('Status 400', () => pm.response.to.have.status(400));"]}}], "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "url": "{{baseUrl}}/transiti", "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{tokenOperatore}}", "type": "string"}]}, "body": {"mode": "raw", "raw": "{\"targa\": 123, \"dataOra\": \"2026-10-07T10:00:00+02:00\", \"tipo\": \"ingresso\", \"varcoId\": {{varcoId}}}"}}},
        {"name": "Elenco transiti del varco", "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('Status 200', () => pm.response.to.have.status(200));"]}}], "request": {"method": "GET", "url": "{{baseUrl}}/transiti?varcoId={{varcoId}}", "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{tokenOperatore}}", "type": "string"}]}}},
        {"name": "Modifica transito senza multa", "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('Status 200', () => pm.response.to.have.status(200));"]}}], "request": {"method": "PUT", "header": [{"key": "Content-Type", "value": "application/json"}], "url": "{{baseUrl}}/transiti/{{transitoId}}", "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{tokenOperatore}}", "type": "string"}]}, "body": {"mode": "raw", "raw": "{\"targa\": \"WL000AA\", \"dataOra\": \"2026-10-07T10:30:00+02:00\", \"tipo\": \"uscita\", \"varcoId\": {{varcoId}}}"}}},
        {"name": "Modifica transito con multa", "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('Status 409', () => pm.response.to.have.status(409));"]}}], "request": {"method": "PUT", "header": [{"key": "Content-Type", "value": "application/json"}], "url": "{{baseUrl}}/transiti/{{transitoConMultaId}}", "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{tokenOperatore}}", "type": "string"}]}, "body": {"mode": "raw", "raw": "{\"targa\": \"AB123CD\", \"dataOra\": \"2026-10-07T10:30:00+02:00\", \"tipo\": \"ingresso\", \"varcoId\": {{varcoId}}}"}}},
        {"name": "Elimina transito con multa", "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('Status 409', () => pm.response.to.have.status(409));"]}}], "request": {"method": "DELETE", "url": "{{baseUrl}}/transiti/{{transitoConMultaId}}", "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{tokenOperatore}}", "type": "string"}]}}},
        {"name": "Elimina transito senza multa", "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('Status 204', () => pm.response.to.have.status(204));"]}}], "request": {"method": "DELETE", "url": "{{baseUrl}}/transiti/{{transitoId}}", "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{tokenOperatore}}", "type": "string"}]}}},
        {"name": "Elenco transiti come dispositivo varco", "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('Status 403', () => pm.response.to.have.status(403));"]}}], "request": {"method": "GET", "url": "{{baseUrl}}/transiti?varcoId={{varcoId}}", "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{tokenVarco}}", "type": "string"}]}}}
      ]
    },
    {
      "name": "Multe",
      "description": "Verifica delle multe a carico dell'automobilista autenticato.",
      "item": [
        {"name": "Multe dell'automobilista", "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('Status 200', () => pm.response.to.have.status(200));", "pm.test('Elenco non vuoto', () => pm.expect(pm.response.json().length).to.be.above(0));"]}}], "request": {"method": "GET", "url": "{{baseUrl}}/multe", "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{tokenAutomobilista}}", "type": "string"}]}}},
        {"name": "Multe come operatore", "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('Status 403', () => pm.response.to.have.status(403));"]}}], "request": {"method": "GET", "url": "{{baseUrl}}/multe", "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{tokenOperatore}}", "type": "string"}]}}}
      ]
    },
    {
      "name": "Bollettini",
      "description": "Download del bollettino PDF con QR code, usando l'idBollettino salvato dal transito con multa.",
      "item": [
        {"name": "Bollettino come automobilista", "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('Status 200', () => pm.response.to.have.status(200));", "pm.test('PDF', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/pdf'));"]}}], "request": {"method": "GET", "url": "{{baseUrl}}/bollettini/{{idBollettino}}", "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{tokenAutomobilista}}", "type": "string"}]}, "description": "In Postman usare 'Send and Download' per salvare il PDF."}},
        {"name": "Bollettino come operatore", "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('Status 200', () => pm.response.to.have.status(200));"]}}], "request": {"method": "GET", "url": "{{baseUrl}}/bollettini/{{idBollettino}}", "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{tokenOperatore}}", "type": "string"}]}}},
        {"name": "Bollettino inesistente", "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('Status 404', () => pm.response.to.have.status(404));"]}}], "request": {"method": "GET", "url": "{{baseUrl}}/bollettini/00000000-0000-4000-8000-000000000000", "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{tokenAutomobilista}}", "type": "string"}]}}},
        {"name": "Bollettino con id non valido", "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('Status 400', () => pm.response.to.have.status(400));"]}}], "request": {"method": "GET", "url": "{{baseUrl}}/bollettini/123", "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{tokenAutomobilista}}", "type": "string"}]}}}
      ]
    },
    {
      "name": "Admin",
      "description": "Ricarica del credito: solo admin, il valore indicato viene sommato al credito attuale.",
      "item": [
        {"name": "Ricarica credito operatore", "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('Status 200', () => pm.response.to.have.status(200));"]}}], "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "url": "{{baseUrl}}/admin/ricarica", "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{tokenAdmin}}", "type": "string"}]}, "body": {"mode": "raw", "raw": "{\"email\": \"operatore@ztl.it\", \"credito\": 5}"}}},
        {"name": "Ricarica con credito come testo", "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('Status 400', () => pm.response.to.have.status(400));"]}}], "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "url": "{{baseUrl}}/admin/ricarica", "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{tokenAdmin}}", "type": "string"}]}, "body": {"mode": "raw", "raw": "{\"email\": \"operatore@ztl.it\", \"credito\": \"5\"}"}}},
        {"name": "Ricarica oltre il massimo", "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('Status 400', () => pm.response.to.have.status(400));"]}}], "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "url": "{{baseUrl}}/admin/ricarica", "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{tokenAdmin}}", "type": "string"}]}, "body": {"mode": "raw", "raw": "{\"email\": \"operatore@ztl.it\", \"credito\": 150}"}}},
        {"name": "Ricarica utente inesistente", "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('Status 404', () => pm.response.to.have.status(404));"]}}], "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "url": "{{baseUrl}}/admin/ricarica", "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{tokenAdmin}}", "type": "string"}]}, "body": {"mode": "raw", "raw": "{\"email\": \"nessuno@ztl.it\", \"credito\": 5}"}}},
        {"name": "Ricarica come operatore", "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('Status 403', () => pm.response.to.have.status(403));"]}}], "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "url": "{{baseUrl}}/admin/ricarica", "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{tokenOperatore}}", "type": "string"}]}, "body": {"mode": "raw", "raw": "{\"email\": \"operatore@ztl.it\", \"credito\": 5}"}}}
      ]
    }
